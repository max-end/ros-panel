{
  "name": "ros-panel",
  "version": "1.0.0",
  "private": false,
  "description": "Modern Web Management Platform for MikroTik RouterOS v7",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "start": "pnpm --filter server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
